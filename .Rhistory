B0 = diag(1, H)
r0 = 300
nu0 = 1.3*k
a_phi = 2
b_phi = 2
# fit stan model
stan_data = list(Q = Q, H = H, k = k, n_q = n, m = m, X = Xcov, b0 = b0, B0 = B0,
a_phi = a_phi, b_phi = b_phi, r0 = r0, nu0 = nu0)
